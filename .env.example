# ---------------------------------------------------------------------------
# MediTrack root environment (used by the server workspace)
# Copy to server/.env and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database
# Provide a real MongoDB connection string (local or Atlas).
# If left empty in development, the server boots an in-memory MongoDB
# (mongodb-memory-server) so you can run without installing MongoDB.
MONGODB_URI=mongodb://localhost:27017/medi-Track
MONGODB_DB_NAME=medi-Track

# Auth
# Must be a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=meditrack_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Uploads / private storage
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10
# s3 | local  (local = private on-disk storage, default)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# OCR / text-extraction provider for prescription + package scanning
# The adapter only READS printed/written text — it never identifies a medicine.
# none | openai | mock
#  - none : no provider; the app reports "not configured" and you enter details manually
#  - openai : real text extraction via an OpenAI-compatible vision endpoint
#  - mock : deterministic sample output for local demos/tests (NOT for production)
OCR_PROVIDER=none
OCR_API_KEY=
OCR_BASE_URL=https://api.openai.com/v1
OCR_MODEL=gpt-4o-mini

# Trusted medicine information source
# none | rxnorm | mock
MEDICINE_INFO_PROVIDER=none
MEDICINE_INFO_API_KEY=
MEDICINE_INFO_BASE_URL=https://rxnav.nlm.nih.gov/REST
MEDICINE_INFO_CACHE_TTL_HOURS=168

# Web Push (external notifications). Optional.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.invalid

# Background scheduler
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_MS=60000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
