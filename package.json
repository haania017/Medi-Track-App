{
  "name": "meditrack",
  "version": "1.0.0",
  "private": true,
  "description": "MediTrack - medicine management, prescription scanning, reminders, stock/expiry tracking and family care (MERN).",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server run start",
    "seed": "npm --workspace server run seed",
    "test": "npm --workspace server run test && npm --workspace client run test",
    "test:server": "npm --workspace server run test",
    "test:client": "npm --workspace client run test",
    "lint": "npm --workspace client run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
